[Unit]
Description=AutoEventPlay – Event-Audio-Player für eventrentmanager
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=aep
Group=aep
SupplementaryGroups=audio
EnvironmentFile=/etc/autoeventplay.env
WorkingDirectory=/opt/autoeventplay
ExecStart=/opt/autoeventplay/.venv/bin/python -m autoeventplay
Restart=always
RestartSec=2
# real-time-ish scheduling for glitch-free audio
Nice=-10
LimitRTPRIO=95
LimitMEMLOCK=infinity
# allow binding to port 80 if AEP_PORT=80 is set
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/autoeventplay

[Install]
WantedBy=multi-user.target
